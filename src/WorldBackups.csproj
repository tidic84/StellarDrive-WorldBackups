<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>WorldBackups</AssemblyName>
    <RootNamespace>WorldBackups</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Version>1.0.0</Version>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <DebugType>none</DebugType>

    <!-- Override on the command line: dotnet build -p:GamePath="D:\SteamLibrary\steamapps\common\StellarDrive Demo" -->
    <GamePath Condition="'$(GamePath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\StellarDrive Demo</GamePath>
    <ManagedPath>$(GamePath)\StellarDrive_Data\Managed</ManagedPath>
    <MelonLoaderPath Condition="'$(MelonLoaderPath)' == ''">$(GamePath)\MelonLoader\net35</MelonLoaderPath>
  </PropertyGroup>

  <ItemGroup>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="MelonLoader"><HintPath>$(MelonLoaderPath)\MelonLoader.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ManagedPath)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.Localization"><HintPath>$(ManagedPath)\Unity.Localization.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(ManagedPath)\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ImageConversionModule"><HintPath>$(ManagedPath)\UnityEngine.ImageConversionModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ScreenCaptureModule" Condition="$(DefineConstants.Contains('SELFTEST')) Or $(DefineConstants.Contains('UIDUMP')) Or $(DefineConstants.Contains('SHOTS'))"><HintPath>$(ManagedPath)\UnityEngine.ScreenCaptureModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.JSONSerializeModule"><HintPath>$(ManagedPath)\UnityEngine.JSONSerializeModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Core"><HintPath>$(ManagedPath)\Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Managers.Interface"><HintPath>$(ManagedPath)\Managers.Interface.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Saving"><HintPath>$(ManagedPath)\Saving.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Saving.Interface"><HintPath>$(ManagedPath)\Saving.Interface.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UI"><HintPath>$(ManagedPath)\UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UI.Interface"><HintPath>$(ManagedPath)\UI.Interface.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Players"><HintPath>$(ManagedPath)\Players.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Players.Interface"><HintPath>$(ManagedPath)\Players.Interface.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(ManagedPath)\Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(ManagedPath)\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(ManagedPath)\UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(MelonLoaderPath)\0Harmony.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

</Project>
